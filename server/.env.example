# Copy this file to .env and fill in real values

PORT=4000

# Admin login (change these!)
ADMIN_EMAIL=admin@dozeles.com
ADMIN_PASSWORD=change-me-now

# JWT secret - use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Optional SMTP for sending contact/booking notification emails.
# If left blank, submissions are still saved to the database - just no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=dozelescleaning@gmail.com
